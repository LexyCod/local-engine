<absolute width="100%" height="100%">
    <style>
        * {
            font-name: "assets/fonts/optimistic.ttf";
            font-size: 14px;
        }
        .panel {
            background-color: #2C2D2F;
            border: 2px solid #444444;
        }
        .title-bar {
            background-color: #1E1F22;
            padding: 5px;
            cursor: move;
        }
    </style>

    <vbox id="windowSettings" width="300" height="540" styleName="panel" left="20" top="20">
        <hbox width="100%" styleName="title-bar" id="dragSettings">
            <label text="Main Settings" style="color: #FFFFFF; font-weight: bold;" />
        </hbox>
        <tabview id="uiBox" width="100%" height="500" style="border: none;">
            <vbox text="Settings" style="padding: 10px; spacing: 8px;" width="100%" height="100%">
		<hbox width="100%" style="spacing: 5px;">
                    <label text="Character:" style="margin-top: 4px;" />
                    <dropdown id="dropCharacter" width="70%" />
                </hbox>

                <checkbox id="chkPlayer" text="Playable Character" />
                
                <hbox width="100%" style="spacing: 5px;">
                    <button id="btnReloadChar" text="Reload Char" width="50%" />
                    <button id="btnReloadImage" text="Reload Image" width="50%" />
                </hbox>
                
                <button id="btnGetIconColor" text="Get Health Color" width="100%" style="margin-bottom: 3px;" />

                <vbox width="100%">
                    <label text="Image File:" />
                    <textfield id="txtImage" width="100%" />
                </vbox>
                
                <hbox width="100%" style="spacing: 10px; vertical-align: center; margin-top: 2px;">
                    <vbox width="70%">
                        <label text="Health Icon:" />
                        <textfield id="txtHealthIcon" width="100%" />
                    </vbox>
                    <vbox width="30%" horizontalAlign="center">
                        <label text="Click Icon" style="font-size: 10px; color: #888888;" />
                        <box id="iconContainer" width="45" height="45" style="background-color: #1E1F22; border: 1px solid #555555; cursor: pointer; border-radius: 4px;" />
                    </vbox>
                </hbox>
                
                <vbox width="100%" style="margin-top: 2px;">
                    <label text="Vocals File:" />
                    <textfield id="txtVocals" width="100%" />
                </vbox>

                <hbox style="spacing: 15px; margin-top: 5px;">
                    <checkbox id="chkFlipX" text="Flip X" />
                    <checkbox id="chkNoAntialiasing" text="No Antialiasing" />
                </hbox>
                
                <hbox width="100%" style="spacing: 5px; margin-top: 5px; vertical-align: center;">
                    <label text="Scale:" />
                    <textfield id="txtScale" width="60" />
                </hbox>
                
                <button id="btnSaveCharacter" text="Save Character" width="100%" style="margin-top: 8px; color: #77FF77;" />
            </vbox>
	    <vbox text="Extra" style="padding: 10px; spacing: 8px;" width="100%" height="100%">
                
                <checkbox id="chkVsliceSustains" text="vSlice Sustains" />
                
                <vbox width="100%" style="spacing: 2px;">
                    <label text="Sing Length:" />
                    <slider id="sldSingDuration" min="1" max="10" pos="4" width="100%" />
                </vbox>
                
                <vbox width="100%" style="spacing: 2px;">
                    <label text="Gameover Character:" />
                    <textfield id="txtGameoverChar" width="100%" />
                </vbox>

                <vbox width="100%" style="spacing: 2px;">
                    <label text="Initial Death Sound:" />
                    <textfield id="txtGameoverInit" width="100%" />
                </vbox>

                <vbox width="100%" style="spacing: 2px;">
                    <label text="Loop Death Sound:" />
                    <textfield id="txtGameoverLoop" width="100%" />
                </vbox>

                <vbox width="100%" style="spacing: 2px;">
                    <label text="Confirm Death Sound:" />
                    <textfield id="txtGameoverConfirm" width="100%" />
                </vbox>

            </vbox>
        </tabview>
    </vbox>

    <vbox id="windowCharacter" width="340" height="530" styleName="panel" left="890" top="20">
        <hbox width="100%" styleName="title-bar" id="dragCharacter">
            <label text="Character Animations" style="color: #FFFFFF; font-weight: bold;" />
        </hbox>
        <tabview width="100%" height="490" style="border: none;">
            <vbox text="List" width="100%" height="100%" style="padding: 10px; spacing: 5px;">
                <label text="Animations List:" />
                <listview id="listAnimations" width="100%" height="150" />
                
                <hbox width="100%" style="spacing: 5px; margin-top: 5px;">
                    <vbox width="50%">
                        <label text="Anim Name:" />
                        <textfield id="txtAnim" width="100%" />
                    </vbox>
                    <vbox width="50%">
                        <label text="Symbol/Tag:" />
                        <textfield id="txtAnimName" width="100%" />
                    </vbox>
                </hbox>
                
                <label text="Frame Indices (e.g. 0,1,2,3):" />
                <textfield id="txtIndices" width="100%" />
                
                <hbox style="spacing: 15px; margin-top: 3px;">
                    <checkbox id="chkAnimLoop" text="Loop?" />
                    <checkbox id="chkAnimFlipX" text="Flip X" />
                    <checkbox id="chkAnimFlipY" text="Flip Y" />
                </hbox>

                <hbox width="100%" style="spacing: 5px; margin-top: 5px;">
                    <button id="btnAddAnim" text="Add/Update Anim" width="50%" />
                    <button id="btnDeleteAnim" text="Delete Anim" width="50%" style="color: #FF7777;" />
                </hbox>

                <hbox width="100%" style="spacing: 5px; margin-top: 5px; vertical-align: center;">
                    <button id="btnMakeGhost" text="Make Ghost" width="50%" />
                    <vbox width="50%">
                        <label text="Ghost Alpha:" />
                        <slider id="sldGhostAlpha" min="0" max="1" pos="0.6" width="100%" />
                    </vbox>
                </hbox>
            </vbox>
        </tabview>
    </vbox>

    <vbox id="colorPickerPanel" hidden="true" styleName="panel" left="250" top="100" width="190" height="260" style="z-index: 100;">
        <hbox width="100%" styleName="title-bar" id="dragColorPicker">
            <label text="Pick Color" style="color: #FFFFFF; font-weight: bold;" />
        </hbox>
        <vbox width="100%" style="padding: 10px; spacing: 10px;" horizontalAlign="center">
            <box id="colorWheelBox" width="180" height="120" style="background-color: #000000; cursor: crosshair;" />
            
            <hbox width="100%" style="spacing: 5px; vertical-align: center;">
                <label text="Preview:" />
                <box id="colorPreview" width="60" height="20" style="background-color: #FFFFFF; border: 1px solid #777777;" />
            </hbox>
            
            <hbox width="100%" style="spacing: 5px;">
                <button id="btnApplyColor" text="Apply" width="50%" style="color: #77FF77;" />
                <button id="btnCancelColor" text="Cancel" width="50%" style="color: #FF7777;" />
            </hbox>
        </vbox>
    </vbox>
</absolute>