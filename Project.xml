<?xml version="1.0" encoding="utf-8"?>
<project>
	<app 
		title="Friday Night Funkin': Local Engine" 
		file="LocalEngine" 
		packageName="com.lexycod.localengine" 
		package="com.lexycod.localengine" 
		main="Main" 
		version="0.2.8" 
		company="LexyCod" 
	/>

	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<define name="MODS_ALLOWED" if="desktop cpp" />
	<define name="HSCRIPT_ALLOWED" if="desktop" />
	<define name="LUA_ALLOWED" if="desktop cpp" />
	<define name="ACHIEVEMENTS_ALLOWED"/>
	<define name="DISCORD_ALLOWED" if="cpp" />
	<define name="PSYCH_WATERMARKS"/>

	<section if="officialBuild">
		<define name="TITLE_SCREEN_EASTER_EGG"/>
		<define name="VIDEOS_ALLOWED" if="cpp windows || cpp linux || cpp android" unless="32bits"/> 
	</section>

	<!-- ____________________________ Window Settings ___________________________ -->

	<window
		width="1280" 
		height="720"  
		fps="60"
		background="#000000" 
		hardware="true" 
		vsync="false" 
	/>

	<window if="html5" resizable="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- ______________________ LOCAL ENGINE CUSTOMIZATION ______________________ -->

	<define name="DEV_BUILD" unless="RELEASE_BUILD" />
	<define name="dev" if="DEV_BUILD" />
	<undefine name="DEV_BUILD" if="RELEASE_BUILD" />
	<define name="LOCAL_WATERMARKS"/>

	<haxeflag name="-D" value="final" if="RELEASE_BUILD" />

	<!-- HL target defines -->
	<define name="MODS_ALLOWED" if="desktop hl" />
	<define name="HSCRIPT_ALLOWED" if="desktop hl" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug"   if="debug" />
	<set name="BUILD_DIR" value="export/release"  unless="debug || DEV_BUILD || dev" />
	<set name="BUILD_DIR" value="export/dev"      if="DEV_BUILD" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit"    if="32bits" />
	<set name="BUILD_DIR" value="export/hl-debug" if="hl debug" />
	<set name="BUILD_DIR" value="export/hl"       if="hl" unless="debug" />

	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->
	
	<define name="CRASH_HANDLER" if="desktop release" />

	<assets path="assets/fonts" />
	<assets path="assets/shared" exclude="*.ogg" if="web"/>
	<assets path="assets/shared" exclude="*.mp3" unless="web"/>
	<assets path="assets/exclude" exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/exclude" exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/soundtray" exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/soundtray" exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets" include="*.zip" embed="false"/>
	<assets path="assets/videos" library="videos" if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs" library="songs" exclude="*.ogg" if="web"/>
	<assets path="assets/songs" library="songs" exclude="*.mp3" unless="web"/>
	<assets path="assets/week_assets" library="week_assets" rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/week_assets" library="week_assets" rename="assets" exclude="*.mp3" unless="web"/>

	<library name="videos" preload="true" if="VIDEOS_ALLOWED"/>
	<library name="songs" preload="true" />
	<library name="week_assets" preload="true" />

	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild"/>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='content' embed='false'/>
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxelib name="flixel-ui" />
	<haxelib name="flixel-addons" />
	<haxelib name="tjson" />
	<haxelib name="hxopus" if="cpp" />
	<haxelib name="haxeui-core" />
	<haxelib name="haxeui-flixel" />

	<haxelib name="moonchart" />

	<haxelib name="linc_luajit" if="cpp" />
	<haxelib name="SScript" if="desktop" />
	<haxelib name="hxCodec" if="cpp" />
	<haxelib name="hxdiscord_rpc" if="cpp" />
	<haxelib name="flxanimate"/>


	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<haxelib name="hxcpp-debug-server" if="debug cpp"/>

	<!-- HL / HashLink target -->
	<section if="hl">
		<haxedef name="HL_BUILD" />
		<haxedef name="FLX_NO_DEBUG" unless="debug" />
		<haxedef name="MODS_ALLOWED" />
		<haxedef name="HSCRIPT_ALLOWED" />
		<haxedef name="ACHIEVEMENTS_ALLOWED" />
	</section>

	<!-- _________________________ cpp optimizations ____________________________ -->

	<section if="cpp" unless="debug">
		<haxedef name="HXCPP_OPTIMIZE_FOR_SIZE" unless="RELEASE_BUILD" />
		<haxedef name="HXCPP_GC_GENERATIONAL" />
		<haxeflag name="--no-traces" unless="DEV_BUILD" />
	</section>

	<section if="RELEASE_BUILD cpp">
    		<haxedef name="HXCPP_STRICT_CASTS" />
	</section>

	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	
	<!-- ______________________________ Haxedefines _____________________________ -->

	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />
	
	<haxedef name='no-deprecation-warnings' />

	<haxeflag name="--macro" value="allowPackage('flash')" />

	<!-- _________________________________ Custom _______________________________ -->

	<assets path='artStuff/iconOG.png' rename='icon.png' if="linux" />
	<icon path="artStuff/icon16.png" size='16'/>
	<icon path="artStuff/icon32.png" size='32'/>
	<icon path="artStuff/icon64.png" size='64'/>
	<icon path="artStuff/iconOG.png" />
</project>
